generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String        @id @default(cuid())
  email               String        @unique
  name                String
  enrollmentNo        String?
  chamberAddress      String?
  phone               String?
  role                String        @default("ADVOCATE")
  passwordHash        String
  reminderLeadMinutes Int           @default(60)
  preferredLanguage   String        @default("EN_HI")
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  clients             Client[]
  cases               Case[]
  hearings            Hearing[]
  caseNotes           CaseNote[]
  documents           Document[]
  tasks               Task[]
  reminders           Reminder[]
  bookmarks           Bookmark[]
  activityLogs        ActivityLog[]
}

model Client {
  id                 String     @id @default(cuid())
  userId             String
  fullName           String
  fatherOrSpouseName String?
  phone              String
  alternatePhone     String?
  email              String?
  address            String?
  city               String     @default("Lucknow")
  district           String     @default("Lucknow")
  privateNotes       String?
  isArchived         Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cases              Case[]
  documents          Document[]
  tasks              Task[]

  @@index([userId, fullName])
  @@index([userId, isArchived])
}

model Case {
  id                  String     @id @default(cuid())
  userId              String
  clientId            String?
  internalCode        String
  title               String
  caseNumber          String?
  cnrNumber           String?
  courtName           String
  courtType           String     @default("CIVIL_COURT")
  caseCategory        String
  petitioner          String
  respondent          String
  filingDate          DateTime?
  nextHearingDate     DateTime?
  previousHearingDate DateTime?
  status              String     @default("PENDING")
  privateNotes        String?
  isArchived          Boolean    @default(false)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  client              Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  hearings            Hearing[]
  notes               CaseNote[]
  documents           Document[]
  tasks               Task[]
  reminders           Reminder[]

  @@index([userId, courtType])
  @@index([userId, status])
  @@index([userId, nextHearingDate])
  @@index([userId, isArchived])
  @@index([clientId])
}

model Hearing {
  id           String     @id @default(cuid())
  userId       String
  caseId       String
  hearingDate  DateTime
  courtRoom    String?
  benchOrJudge String?
  purpose      String
  outcomeNotes String?
  status       String     @default("SCHEDULED")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  case         Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  reminders    Reminder[]

  @@index([userId, hearingDate])
  @@index([caseId, hearingDate])
}

model CaseNote {
  id        String   @id @default(cuid())
  userId    String
  caseId    String
  title     String
  content   String
  isPrivate Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@index([userId])
}

model Document {
  id               String   @id @default(cuid())
  userId           String
  caseId           String?
  clientId         String?
  title            String
  category         String   @default("OTHER")
  originalFilename String
  storedFilename   String
  mimeType         String
  fileSize         Int
  storagePath      String
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  case             Case?    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  client           Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([userId, caseId])
  @@index([userId, clientId])
  @@index([userId, category])
}

model Task {
  id          String     @id @default(cuid())
  userId      String
  caseId      String?
  clientId    String?
  title       String
  description String?
  dueDate     DateTime
  priority    String     @default("MEDIUM")
  isCompleted Boolean    @default(false)
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  case        Case?      @relation(fields: [caseId], references: [id], onDelete: SetNull)
  client      Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  reminders   Reminder[]

  @@index([userId, isCompleted, dueDate])
}

model Reminder {
  id          String   @id @default(cuid())
  userId      String
  caseId      String?
  hearingId   String?
  taskId      String?
  title       String
  message     String
  remindAt    DateTime
  channel     String   @default("IN_APP")
  isRead      Boolean  @default(false)
  isDismissed Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  case        Case?    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  hearing     Hearing? @relation(fields: [hearingId], references: [id], onDelete: SetNull)
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, remindAt, isDismissed])
}

model PortalCategory {
  id            String       @id @default(cuid())
  slug          String       @unique
  nameEn        String
  nameHi        String
  descriptionEn String
  descriptionHi String
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  links         PortalLink[]
}

model PortalLink {
  id               String         @id @default(cuid())
  categoryId       String
  titleEn          String
  titleHi          String
  descriptionEn    String
  descriptionHi    String
  url              String
  officialAgency   String
  requiredInputsEn String
  requiredInputsHi String
  safetyNoteEn     String?
  safetyNoteHi     String?
  isFeatured       Boolean        @default(false)
  sortOrder        Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  category         PortalCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  bookmarks        Bookmark[]

  @@index([categoryId, sortOrder])
}

model Bookmark {
  id           String      @id @default(cuid())
  userId       String
  portalLinkId String?
  title        String
  url          String
  category     String      @default("OTHER")
  notes        String?
  isOfficial   Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  portalLink   PortalLink? @relation(fields: [portalLinkId], references: [id], onDelete: SetNull)

  @@index([userId, category])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  summary    String
  ipAddress  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}
