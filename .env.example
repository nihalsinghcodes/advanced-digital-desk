# Database Connection
# Local SQLite (default for development)
DATABASE_URL="file:./dev.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://advocate_user:strong_password@localhost:5432/advocate_desk?schema=public"

# Session signing secret (generate a long random string in production, e.g. openssl rand -hex 32)
SESSION_SECRET="replace-with-a-long-random-secret-in-production"

# Application URL & Port
APP_URL="http://localhost:3000"
PORT=3000
NODE_ENV="development"

# Private document upload directory (kept outside public static directories)
UPLOAD_DIR="./storage/uploads"

# GEMINI_API_KEY: Reserved for AI Studio environment if needed
GEMINI_API_KEY=""
